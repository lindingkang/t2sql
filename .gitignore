# 数据集（1.2GB 二进制文件，git 擅长管理文本代码，大文件会让仓库永久膨胀。
# 每个协作者/每台机器各自下载数据即可，代码里约定好路径就行）
spider/

# Python 运行产物
__pycache__/
*.pyc

# 环境变量与 API key（M1 起调模型 API 会用到，key 泄露进 git 历史基本无法彻底清除）
.env

# 运行时产物与评测结果（大文件不入库，结论维护在 learning_notes.md）
.cache/
.vscode/
*.log
*.pid
m3_eval_logs/
_*.txt
/agent_eval_m3.json
/_scratch/

# M4 目录：生成数据与评测明细不入库，只提交 .py 脚本（结论维护在 learning_notes.md）
m4/*
!m4/*.py
